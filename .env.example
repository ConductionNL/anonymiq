# Anonymiq API Environment Configuration
# Copy this file to.env and adjust the values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Debug mode - set to false in production
DEBUG=true

# Server mode for Uvicorn (development, staging, production)
UVICORN_SERVER_MODE=development

# =============================================================================
# NLP MODEL CONFIGURATION
# =============================================================================

# Default language for text processing
DEFAULT_LANGUAGE=nl

# NLP Engine to use: "spacy" or "transformers"
DEFAULT_NLP_ENGINE=spacy

# SpaCy model for Dutch text processing
# Download with: python -m spacy download nl_core_news_md
DEFAULT_SPACY_MODEL=nl_core_news_md

# Transformers model for Dutch text processing (alternative to SpaCy)
DEFAULT_TRANSFORMERS_MODEL=pdelobelle/robbert-v2-dutch-base

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Crypto key for encryption/decryption operations
# Generate a secure key for production: openssl rand -hex 32
# CRYPTO_KEY=your-secure-crypto-key-here

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Browser origins allowed to call the API (comma separated). Leave empty to
# keep CORS off: server to server callers send no Origin header and need none.
# A wildcard "*" is refused at startup.
ALLOWED_ORIGINS=

# HTTP Basic credentials for the /api/v1/documents routes. Without a password
# every document request is refused with 401.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Database URL - defaults to SQLite if not specified
#
# NOTE: the SQLite FILENAME stays `openanonymiser.db` across the Anonymiq
# rename. It is the name of a file that already exists on the deployed
# PersistentVolumeClaim, and the Helm chart hardcodes the same path. Changing
# it here would not error — SQLite would simply create a new, EMPTY database
# beside the real one, and the service would come up looking freshly
# installed. The filename moves only together with a migration of the volume.
#
# For SQLite: sqlite:///./openanonymiser.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=sqlite:///./openanonymiser.db

# =============================================================================
# FILE STORAGE
# =============================================================================

# Directory for temporary file uploads
TEMP_FILES_DIR=./temp

# Directory for log files
LOGS_DIR=./logs

# Supported file extensions for upload (comma-separated)
SUPPORTED_UPLOAD_EXTENSIONS=pdf,txt,docx

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================

# API host and port
API_HOST=0.0.0.0
API_PORT=8080

# Number of worker processes (for production)
API_WORKERS=1
